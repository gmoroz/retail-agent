# Copy to .env and fill in real values. .env is gitignored.

# Provider-agnostic OpenAI-compatible /chat/completions endpoint.
# The default provider is OpenRouter and the default model is the A/B winner.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Use the same OpenRouter key as OPENROUTER_API_KEY for normal chat runs.
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash

# OpenRouter key for chat, baai/bge-m3 embeddings, the A/B model sweep and the judge.
OPENROUTER_API_KEY=

# GCP project used for BigQuery billing; bigquery-public-data.thelook_ecommerce
# is read from this project.
GOOGLE_CLOUD_PROJECT=

# Service-account JSON path. Leave unset to use Application Default Credentials
# (run `gcloud auth application-default login`).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/key.json

# Native postgresql:// form. The bare-psycopg LangGraph checkpointer connects to
# it unchanged; SQLAlchemy consumers (Alembic env, Golden-bucket engine) derive
# the postgresql+psycopg:// driver form via Settings.sqlalchemy_url (ADR-021).
DB_URI=postgresql://postgres:postgres@localhost:5432/postgres
